{
  "name": "archlens",
  "version": "0.2.2",
  "private": true,
  "description": "Local-first architecture-impact reports for repositories.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @archlens/core typecheck && pnpm --filter @archlens/core build && pnpm --filter @archlens/cli typecheck",
    "test": "pnpm -r test",
    "archlens": "node apps/cli/dist/index.js",
    "smoke:pack": "scripts/smoke-pack.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
