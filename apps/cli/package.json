{
  "name": "@archlens/cli",
  "version": "0.2.2",
  "description": "Local-first architecture-impact reports for repositories.",
  "type": "module",
  "bin": {
    "archlens": "dist/index.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@archlens/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
