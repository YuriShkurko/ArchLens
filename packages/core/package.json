    "test": "vitest run"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
