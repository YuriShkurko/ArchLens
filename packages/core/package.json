{
  "name": "@archlens/core",
  "version": "0.2.2",
  "description": "Core library for local-first architecture-impact reports for repositories.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
